@page "{id:int}"
@model ReservationHotelProjet.Pages.Chambres.DetailsModel

<h1>Chambre @Model.Chambre.Numero</h1>
<p>Type : @Model.Chambre.Type</p>
<p>Prix : @Model.Chambre.Prix€</p>
<p>@Model.Chambre.Description</p>

<a asp-page="/Reservations/Create" asp-route-idChambre="@Model.Chambre.IdChambre" class="btn btn-success">
    Réserver
</a>
<a asp-page="/Chambres/Index" class="btn btn-secondary">Retour</a>



@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="hero">
    <h1>Bienvenue</h1>
    <p>Réservez votre chambre et profitez d'un séjour inoubliable</p>
    <a asp-page="/Chambres/Index" class="btn-hero">Voir nos chambres</a>
</div>

<div class="features">
    <div class="feature-card">
        <h3>Chambres confortables</h3>
        <p>Simple, double, suite ou familiale</p>
    </div>
    <div class="feature-card">
        <h3>Réservation facile</h3>
        <p>Réservez en quelques clics</p>
    </div>
</div>

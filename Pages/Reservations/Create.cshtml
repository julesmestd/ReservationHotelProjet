@page "{idChambre:int}"
@model ReservationHotelProjet.Pages.Reservations.CreateModel

<h1>Réserver la chambre @Model.Chambre.Numero</h1>

<form method="post" asp-route-idChambre="@Model.Chambre.IdChambre">
    <div class="mb-3">
        <label asp-for="Reservation.DateDebut">Date d'arrivée</label>
        <input asp-for="Reservation.DateDebut" type="date" class="form-control" />
        <span asp-validation-for="Reservation.DateDebut" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Reservation.DateFin">Date de départ</label>
        <input asp-for="Reservation.DateFin" type="date" class="form-control" />
        <span asp-validation-for="Reservation.DateFin" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Confirmer la réservation</button>
    <a asp-page="/Chambres/Details" asp-route-id="@Model.Chambre.IdChambre" class="btn btn-secondary">Annuler</a>
</form>